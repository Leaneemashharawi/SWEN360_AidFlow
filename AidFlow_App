<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>AidFlow</title><style>
:root{--blue:#223e91;--green:#10b981;--pale:#dbeafe;--ink:#202b3b;--muted:#737e90;--line:#e0e5ed;--soft:#f2f3f6}*{box-sizing:border-box}body{margin:0;background:#eef2f7;color:var(--ink);font-family:Arial,Helvetica,sans-serif}.phone{max-width:430px;min-height:100vh;margin:auto;background:white;position:relative;box-shadow:0 0 25px #cdd5df}header{padding:22px 24px 10px;display:flex;align-items:center;justify-content:space-between}.brand{font-size:25px;font-weight:800;color:var(--blue)}.logo{display:inline-flex;align-items:center;justify-content:center;background:var(--pale);width:44px;height:44px;border-radius:50%;font-size:25px}.headleft{display:flex;gap:10px;align-items:center}.iconbtn{border:0;background:var(--soft);border-radius:13px;padding:12px;color:var(--blue);cursor:pointer}.page{padding:12px 24px 105px;min-height:calc(100vh - 160px)}h1{font-size:25px;margin:12px 0 8px}h2{font-size:19px;margin:20px 0 12px}h3{font-size:17px;margin:0 0 7px}p{line-height:1.45}.muted{color:var(--muted)}.small{font-size:13px}.card{border:1px solid var(--line);border-radius:13px;padding:15px;margin:12px 0;background:white}.feature{background:var(--pale);border:0}.btn{width:100%;padding:16px;border:0;border-radius:12px;background:var(--blue);color:white;font-weight:700;font-size:15px;cursor:pointer;margin:8px 0}.btn.green{background:var(--green)}.btn.light{background:var(--pale);color:var(--blue)}.btn.danger{background:#fee2e2;color:#a11b1b}.btn.slim{padding:10px;font-size:13px}.row{display:flex;align-items:center;justify-content:space-between;gap:9px}.row>*{min-width:0}.progress{height:6px;border-radius:20px;background:#eef0f4;overflow:hidden;flex:1}.progress span{display:block;background:var(--green);height:100%}.progressline{display:flex;align-items:center;gap:15px;margin:28px 0 10px}.progressline strong{font-size:12px;color:var(--blue)}label{display:block;font-size:14px;margin:17px 0 8px}input,select,textarea{font:inherit;width:100%;border:0;border-radius:12px;background:var(--soft);padding:16px;color:var(--ink)}textarea{min-height:82px;resize:vertical}nav{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:min(430px,100%);display:flex;justify-content:space-around;border-top:1px solid var(--line);background:white;padding:9px 4px 13px}nav button{border:0;background:none;color:var(--muted);font-size:11px;cursor:pointer;min-width:70px}nav button span{display:block;font-size:22px;padding:5px}nav button.active{color:var(--blue);font-weight:bold}nav button.active span{background:var(--pale);border-radius:12px}.auth{padding-top:15px}.auth .hero{text-align:center;margin:0 0 40px}.auth .hero .logo{width:74px;height:74px;font-size:40px}.auth .hero h1{color:var(--blue);font-size:33px}.auth footer{text-align:center;margin-top:55px}.link{border:0;background:none;color:var(--green);font-weight:700;cursor:pointer}.tabs{display:flex;gap:8px;flex-wrap:wrap}.tabs button{background:var(--soft);border:0;padding:9px;border-radius:9px;cursor:pointer}.tabs .chosen{background:var(--pale);color:var(--blue)}.pill{font-size:12px;border-radius:20px;padding:5px 9px;background:#edf3ff;color:var(--blue)}.notice{padding:11px;background:#e7f8f0;border-radius:10px;margin:10px 0}.error{background:#ffe5e5;color:#9a1d1d}.qty{display:flex;align-items:center;justify-content:space-between;background:var(--soft);border-radius:12px;padding:8px}.qty button{border:0;background:white;border-radius:8px;padding:9px 14px;font-size:20px;color:var(--blue)}.hidden{display:none}@media(min-width:650px){.phone{margin:25px auto;min-height:850px;border-radius:18px;overflow:hidden}nav{bottom:0}}
</style></head><body><div class="phone"><header id="header"></header><main class="page" id="app"></main><nav id="nav"></nav></div><script>
const KEY='aidflow_demo_v1';const seed={users:[{id:'demo-donor',name:'Demo Donor',email:'donor@aidflow.test',password:'demo123',role:'Donor'},{id:'demo-coordinator',name:'Demo Coordinator',email:'coordinator@aidflow.test',password:'demo123',role:'Campaign Coordinator'},{id:'demo-volunteer',name:'Demo Volunteer',email:'volunteer@aidflow.test',password:'demo123',role:'Volunteer'},{id:'demo-storage',name:'Demo Storage',email:'storage@aidflow.test',password:'demo123',role:'Storage Staff'},{id:'demo-admin',name:'Demo Admin',email:'admin@aidflow.test',password:'demo123',role:'Administrator'}],campaigns:[{id:'food',name:'Food Donation Drive',org:'Community Support Center',description:'Help families in need by donating essential food supplies.',items:[{name:'Rice',unit:'bags',needed:30,received:19},{name:'Cooking Oil',unit:'bottles',needed:20,received:13},{name:'Canned Food',unit:'cans',needed:50,received:33}]},{id:'school',name:'School Supplies Campaign',org:'Education Support Foundation',description:'Help students receive school supplies.',items:[{name:'Notebooks',unit:'packs',needed:40,received:16},{name:'Pencils',unit:'boxes',needed:20,received:8}]}],donations:[],tasks:[],activity:[]};
let db;try{db=JSON.parse(localStorage.getItem(KEY))||structuredClone(seed)}catch(e){db=structuredClone(seed)}let current=localStorage.getItem('aidflow_user')||'',page=current?'home':'login',campaignId='food',qty=5,item='Rice',notice='';const $=id=>document.getElementById(id),save=()=>localStorage.setItem(KEY,JSON.stringify(db)),me=()=>db.users.find(u=>u.id===current),esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])),id=()=>Math.random().toString(36).slice(2,10),allowed=(...roles)=>me()&&roles.includes(me().role),go=p=>{page=p;notice='';render();window.scrollTo(0,0)},say=(s,bad=false)=>{notice=(bad?'ERROR: ':'')+s;render()},log=(s)=>{db.activity.unshift({text:s,time:new Date().toLocaleString()});db.activity=db.activity.slice(0,30)};const camp=()=>db.campaigns.find(c=>c.id===campaignId)||db.campaigns[0],percent=c=>{let n=c.items.reduce((a,x)=>a+x.needed,0),r=c.items.reduce((a,x)=>a+x.received,0);return n?Math.min(100,Math.round(r/n*100)):0},btn=(s,fn,cls='')=>`<button class="btn ${cls}" onclick="${fn}">${s}</button>`,badge=s=>`<span class="pill">${esc(s)}</span>`,formval=x=>$(x)?.value?.trim()||'';
function render(){let auth=!!me();$('header').innerHTML=page==='login'||page==='signup'?'':`<div class="headleft"><button class="iconbtn" onclick="historyBack()">←</button><strong>${['home','campaigns','mydonations','profile'].includes(page)?'<span class="brand">AidFlow</span>':esc(({details:'Campaign Details',donate:'Make a Donation',tasks:'Volunteer Tasks',inventory:'Inventory',coordinator:'Coordinator Dashboard',admin:'Administration'}[page]||'AidFlow'))}</strong></div><span class="logo">💚</span>`;$('nav').innerHTML=auth?['home','campaigns','mydonations','profile'].map((p,i)=>`<button class="${page===p?'active':''}" onclick="go('${p}')"><span>${['⌂','⚑','♡','♙'][i]}</span>${['Home','Campaigns','My Donations','Profile'][i]}</button>`).join(''):'';let content='';if(!auth&& !['login','signup'].includes(page))page='login';switch(page){case'login':content=`<div class="auth"><div class="hero"><div class="logo">💚</div><h1>AidFlow</h1><p class="muted">Connecting Generosity with Those in Need</p></div><h1>Welcome Back!</h1><p class="muted">Sign in to manage donations and make a difference.</p><form onsubmit="login(event)"><label>Email Address</label><input id="email" type="email" required placeholder="Enter your email"><label>Password</label><input id="password" type="password" required placeholder="Enter your password">${btn('Log In','', '') .replace('onclick=""','type="submit"')}</form><p class="small muted">Demo: donor@aidflow.test / demo123 (other roles on Profile after login)</p><footer>Don't have an account? <button class="link" onclick="go('signup')">Sign Up</button></footer></div>`;break;case'signup':content=`<h1>Create Account</h1><form onsubmit="signup(event)"><label>Full Name</label><input id="name" required><label>Email</label><input id="email" type="email" required><label>Password (at least 6 characters)</label><input id="password" type="password" minlength="6" required>${btn('Sign Up','').replace('onclick=""','type="submit"')}</form><button class="link" onclick="go('login')">Back to Login</button>`;break;case'home':content=`<h1>Welcome to AidFlow!</h1><p class="muted">Your kindness can make a difference.</p><section class="card feature"><h3 style="color:var(--blue)">Make an Impact</h3><p>Support people in need through donation campaigns.</p>${btn('Explore Campaigns',"go('campaigns')",'green')}</section><h2>Active Campaigns</h2>${db.campaigns.map(c=>campaignCard(c)).join('')}<h2>Recent Activities</h2>${db.activity.length?db.activity.slice(0,4).map(a=>`<p class="small">${esc(a.text)} <span class="muted">${esc(a.time)}</span></p>`).join(''):'<p class="muted small">No recent activity yet.</p>'}${roleLinks()}`;break;case'campaigns':content=`<h1>Campaigns</h1><p class="muted">Browse active donation campaigns.</p><input id="search" placeholder="Search campaigns" oninput="filterCampaigns()"><div id="campaignList">${db.campaigns.map(c=>campaignCard(c)).join('')}</div>${roleLinks()}`;break;case'details':{let c=camp();content=`<h1>${esc(c.name)}</h1><p class="muted">${esc(c.org)}</p><p>${esc(c.description)}</p><section class="card feature"><div class="row"><h3 style="color:var(--blue)">Donation Progress</h3><strong>${percent(c)}%</strong></div><div class="progress"><span style="width:${percent(c)}%"></span></div><p class="small">${percent(c)}% of requested items received</p></section><h2>Requested Items</h2>${c.items.map(x=>`<div class="card"><strong>${esc(x.name)}</strong> — ${Math.max(0,x.needed-x.received)} ${esc(x.unit)} needed</div>`).join('')}${btn('Donate Now',"go('donate')")}`;break}case'donate':{let c=camp();if(!c.items.some(x=>x.name===item))item=c.items[0]?.name||'';let it=c.items.find(x=>x.name===item);content=`<h1>${esc(c.name)}</h1><p class="muted">${esc(c.org)}</p><h2>Donation Details</h2><label>Select Item</label><select id="item" onchange="selectDonationItem(this.value)">${c.items.map(x=>`<option ${item===x.name?'selected':''}>${esc(x.name)}</option>`).join('')}</select><p class="small muted">Options: ${c.items.map(x=>esc(x.name)).join(' · ')}</p><label>Quantity</label><div class="qty"><button onclick="qty=Math.max(1,qty-1);render()">−</button><strong>${qty} ${esc(it?.unit||'items')}</strong><button onclick="qty++;render()">＋</button></div><label>Additional Notes (Optional)</label><textarea id="notes" placeholder="Enter any additional information"></textarea><section class="card feature"><h3 style="color:var(--blue)">Donation Summary</h3><p class="row">Item: <strong>${esc(item)}</strong></p><p class="row">Quantity: <strong>${qty} ${esc(it?.unit||'items')}</strong></p><p class="row">Status: <strong>Pending Confirmation</strong></p></section>${btn('Submit Donation','submitDonation()','green')}<p class="small muted" style="text-align:center">The organization will review your donation offer.</p>`;break}case'mydonations':{let mine=db.donations.filter(d=>d.userId===current);content=`<h1>My Donations</h1><p class="muted">Track your donation offers.</p>${mine.length?mine.map(d=>{let c=db.campaigns.find(x=>x.id===d.campaignId);return `<div class="card"><h3>${esc(c?.name||'Campaign')}</h3><p>${esc(d.item)} · ${d.qty} ${esc(d.unit)}</p><p>Status: ${badge(d.status)}</p><p class="small muted">${esc(d.notes)}</p></div>`}).join(''):'<p class="muted">No donations yet.</p>'}`;break}case'profile':content=`<h1>My Profile</h1><p>${badge(me().role)}</p><form onsubmit="updateProfile(event)"><label>Name</label><input id="name" value="${esc(me().name)}" required><label>Email</label><input id="email" type="email" value="${esc(me().email)}" required>${btn('Save Profile','').replace('onclick=""','type="submit"')}</form>${roleLinks()}${btn('Log Out','logout()','danger')}<p class="small muted">Demo roles: donor@aidflow.test, coordinator@aidflow.test, volunteer@aidflow.test, storage@aidflow.test, admin@aidflow.test. Password: demo123.</p>`;break;case'coordinator':content=allowed('Campaign Coordinator','Administrator')?coordinatorPage():'<p>Access denied.</p>';break;case'tasks':content=allowed('Volunteer','Campaign Coordinator','Administrator')?tasksPage():'<p>Access denied.</p>';break;case'inventory':content=allowed('Storage Staff','Campaign Coordinator','Administrator')?inventoryPage():'<p>Access denied.</p>';break;case'admin':content=allowed('Administrator')?adminPage():'<p>Access denied.</p>';break} $('app').innerHTML=(notice?`<div class="notice ${notice.startsWith('ERROR')?'error':''}">${esc(notice)}</div>`:'')+content}
function historyBack(){go(['details','donate'].includes(page)?'campaigns':'home')}function campaignCard(c){return `<section class="card"><h3>${esc(c.name)}</h3><div class="muted small">${esc(c.org)}</div><p>${esc(c.description)}</p><div class="progressline"><div class="progress"><span style="width:${percent(c)}%"></span></div><strong>${percent(c)}%</strong></div>${btn('View Details',`campaignId='${c.id}';go('details')`,'slim')}</section>`}function filterCampaigns(){let q=formval('search').toLowerCase();$('campaignList').innerHTML=db.campaigns.filter(c=>(c.name+' '+c.description).toLowerCase().includes(q)).map(c=>campaignCard(c)).join('')||'<p>No matching campaigns.</p>'}function roleLinks(){let links=[];if(allowed('Campaign Coordinator','Administrator'))links.push(['Coordinator Dashboard','coordinator']);if(allowed('Volunteer','Campaign Coordinator','Administrator'))links.push(['Volunteer Tasks','tasks']);if(allowed('Storage Staff','Campaign Coordinator','Administrator'))links.push(['Inventory','inventory']);if(allowed('Administrator'))links.push(['Administration','admin']);return links.length?`<h2>Role Tools</h2>${links.map(([n,p])=>btn(n,`go('${p}')`,'light slim')).join('')}`:''}
function login(e){e.preventDefault();let u=db.users.find(x=>x.email.toLowerCase()===formval('email').toLowerCase()&&x.password===$('password').value);if(!u)return say('Invalid email or password.',true);current=u.id;localStorage.setItem('aidflow_user',current);go('home')}function signup(e){e.preventDefault();let email=formval('email').toLowerCase();if(db.users.some(x=>x.email.toLowerCase()===email))return say('Email already exists.',true);let u={id:id(),name:formval('name'),email,password:$('password').value,role:'Donor'};db.users.push(u);save();current=u.id;localStorage.setItem('aidflow_user',current);go('home')}function logout(){current='';localStorage.removeItem('aidflow_user');go('login')}function updateProfile(e){e.preventDefault();let email=formval('email');if(db.users.some(u=>u.id!==current&&u.email.toLowerCase()===email.toLowerCase()))return say('Email already used.',true);me().name=formval('name');me().email=email;save();say('Profile updated.')}function selectDonationItem(selected){const c=camp();if(!c.items.some(x=>x.name===selected))return;item=selected;const notes=$('notes')?.value||'';render();if($('notes'))$('notes').value=notes;}function submitDonation(){if(!allowed('Donor','Administrator'))return say('Only donors can submit offers. Sign in as a donor.',true);if(!Number.isInteger(qty)||qty<=0)return say('Quantity must be greater than zero.',true);let c=camp(),it=c.items.find(x=>x.name===item);if(!it)return say('Choose a valid item.',true);db.donations.push({id:id(),userId:current,campaignId:c.id,item,unit:it.unit,qty,notes:formval('notes'),status:'Pending',allocated:false});log('New donation offer for '+c.name);save();qty=5;go('mydonations');say('Donation submitted for coordinator review.')}function coordinatorPage(){return `<h1>Campaign Management</h1><h2>Create Campaign</h2><form onsubmit="createCampaign(event)"><label>Campaign Name</label><input id="cname" required><label>Organization</label><input id="corg" required><label>Description</label><textarea id="cdesc" required></textarea><label>Requested item</label><input id="citem" required><label>Quantity needed</label><input id="cqty" type="number" min="1" required><label>Unit</label><input id="cunit" placeholder="bags, boxes, items" required>${btn('Create Campaign','').replace('onclick=""','type="submit"')}</form><h2>Manage Campaigns</h2>${db.campaigns.map(c=>`<div class="card"><h3>${esc(c.name)}</h3><p>${esc(c.description)}</p>${btn('Edit Description',`editCampaign('${c.id}')`,'light slim')}${btn('Delete Campaign',`deleteCampaign('${c.id}')`,'danger slim')}</div>`).join('')}<h2>Donation Approval</h2>${db.donations.map(d=>`<div class="card"><p><strong>${esc(d.item)}</strong> × ${d.qty} · ${esc(db.users.find(u=>u.id===d.userId)?.name)}</p><p>${badge(d.status)}</p>${d.status==='Pending'?btn('Accept',`setDonation('${d.id}','Accepted')`,'green slim')+btn('Reject',`setDonation('${d.id}','Rejected')`,'danger slim'):''}</div>`).join('')||'<p class="muted">No offers yet.</p>'}${btn('Volunteer Task Management',"go('tasks')",'light')}`}function createCampaign(e){e.preventDefault();let q=Number(formval('cqty'));if(!Number.isInteger(q)||q<1)return say('Invalid quantity.',true);db.campaigns.push({id:id(),name:formval('cname'),org:formval('corg'),description:formval('cdesc'),items:[{name:formval('citem'),needed:q,received:0,unit:formval('cunit')}]});log('Campaign created');save();say('Campaign created.')}function editCampaign(cid){let c=db.campaigns.find(x=>x.id===cid),v=prompt('Update description',c.description);if(v===null)return;c.description=v.trim();log('Campaign updated');save();say('Campaign updated.')}function deleteCampaign(cid){if(db.donations.some(d=>d.campaignId===cid))return say('Cannot delete a campaign with donation records.',true);if(!confirm('Delete this campaign?'))return;db.campaigns=db.campaigns.filter(c=>c.id!==cid);save();say('Campaign deleted.')}function setDonation(did,status){let d=db.donations.find(x=>x.id===did);if(!d||!allowed('Campaign Coordinator','Administrator'))return;d.status=status;log('Donation '+status.toLowerCase());save();say('Donation '+status.toLowerCase()+'.')}
function tasksPage(){return `<h1>Collection & Delivery Tasks</h1><p class="muted">Create, prioritize, complete, and delete tasks.</p><form onsubmit="createTask(event)"><label>Task title</label><input id="ttitle" required><label>Task type</label><select id="ttype"><option>Collection</option><option>Delivery</option></select><label>Priority</label><select id="tpriority"><option>High</option><option>Medium</option><option>Low</option></select><label>Assign to volunteer</label><select id="tuser">${db.users.filter(u=>u.role==='Volunteer').map(u=>`<option value="${u.id}">${esc(u.name)}</option>`).join('')}</select>${btn('Create Task','').replace('onclick=""','type="submit"')}</form><h2>Tasks</h2>${db.tasks.filter(t=>allowed('Campaign Coordinator','Administrator')||t.userId===current).sort((a,b)=>({High:0,Medium:1,Low:2}[a.priority]-{High:0,Medium:1,Low:2}[b.priority])).map(t=>`<div class="card"><div class="row"><h3>${esc(t.title)}</h3>${badge(t.priority)}</div><p>${esc(t.type)} · ${t.done?'Completed':'Open'}</p>${btn(t.done?'Mark Incomplete':'Mark Complete',`toggleTask('${t.id}')`,'green slim')}${btn('Delete Task',`deleteTask('${t.id}')`,'danger slim')}</div>`).join('')||'<p class="muted">No tasks yet.</p>'}`}function createTask(e){e.preventDefault();if(!allowed('Volunteer','Campaign Coordinator','Administrator'))return;db.tasks.push({id:id(),title:formval('ttitle'),type:formval('ttype'),priority:formval('tpriority'),userId:formval('tuser')||current,done:false});log('Task created');save();say('Task created.')}function toggleTask(tid){let t=db.tasks.find(x=>x.id===tid);if(!t)return;t.done=!t.done;log('Task completion changed');save();say('Task updated.')}function deleteTask(tid){db.tasks=db.tasks.filter(t=>t.id!==tid);log('Task deleted');save();say('Task deleted.')}
function inventoryPage(){return `<h1>Inventory Management</h1><p class="muted">Record received items and update donation status.</p><h2>Accepted Donations</h2>${db.donations.filter(d=>['Accepted','Received','Allocated','Delivered'].includes(d.status)).map(d=>`<div class="card"><h3>${esc(d.item)} · ${d.qty} ${esc(d.unit)}</h3><p>${badge(d.status)}</p>${d.status==='Accepted'?btn('Mark Received',`receiveDonation('${d.id}')`,'green slim'):''}${d.status==='Received'?btn('Mark Allocated',`advanceDonation('${d.id}','Allocated')`,'light slim'):''}${d.status==='Allocated'?btn('Mark Delivered',`advanceDonation('${d.id}','Delivered')`,'green slim'):''}</div>`).join('')||'<p class="muted">No accepted donations yet.</p>'}<h2>Campaign Inventory</h2>${db.campaigns.map(c=>`<div class="card"><h3>${esc(c.name)}</h3>${c.items.map(x=>`<p>${esc(x.name)}: ${x.received} ${esc(x.unit)} received / ${x.needed} requested</p>`).join('')}</div>`).join('')}`}function receiveDonation(did){if(!allowed('Storage Staff','Campaign Coordinator','Administrator'))return;let d=db.donations.find(x=>x.id===did);if(!d||d.status!=='Accepted')return;let c=db.campaigns.find(x=>x.id===d.campaignId),it=c?.items.find(x=>x.name===d.item);if(!it)return say('Requested item not found.',true);it.received+=d.qty;d.status='Received';log('Donation received into inventory');save();say('Received and inventory updated.')}function advanceDonation(did,status){let d=db.donations.find(x=>x.id===did);if(!d)return;if(status==='Allocated'&&d.status==='Received'&&!d.allocated){d.allocated=true;d.status=status}else if(status==='Delivered'&&d.status==='Allocated'){d.status=status}else return say('Invalid status transition.',true);log('Donation marked '+status);save();say('Status updated.')}function adminPage(){return `<h1>Administration</h1><h2>Manage Users</h2>${db.users.map(u=>`<div class="card"><strong>${esc(u.name)}</strong><p class="small">${esc(u.email)}</p><select onchange="changeRole('${u.id}',this.value)">${['Donor','Campaign Coordinator','Volunteer','Storage Staff','Administrator'].map(r=>`<option ${u.role===r?'selected':''}>${r}</option>`).join('')}</select></div>`).join('')}<h2>Activity Log</h2>${db.activity.map(a=>`<p class="small">${esc(a.text)} — ${esc(a.time)}</p>`).join('')||'<p class="muted">No activity yet.</p>'}`}function changeRole(uid,role){if(uid===current)return say('Cannot change your own administrator role.',true);db.users.find(u=>u.id===uid).role=role;log('User role changed');save();say('Role updated.')}render();
</script></body></html>
